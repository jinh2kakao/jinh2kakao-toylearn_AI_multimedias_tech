    {
      "parameters": {
        "jsCode": "// 다중 파일 처리 어댑터 (Multi-file Adapter)\n// 폼에서 들어온 여러 파일을 개별 아이템으로 분리합니다.\n\nconst results = [];\nconst inputItem = items[0];\nconst idea = inputItem.json.idea_input;\n\n// 바이너리 데이터가 있는지 확인\nif (inputItem.binary) {\n  // 모든 바이너리 키(업로드된 파일들)를 순회\n  Object.keys(inputItem.binary).forEach(key => {\n    results.push({\n      json: {\n        idea_input: idea,\n        filename: inputItem.binary[key].fileName,\n        file_source: 'upload_files' \n      },\n      binary: {\n        // 중요: n8n의 표준 데이터 키인 'data'로 매핑해야 Loader가 인식함\n        data: inputItem.binary[key]\n      }\n    });\n  });\n}\n\nreturn results;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
